# =============================================================================
# Irie's Cuisine — environment variables
# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are visible in the browser — never put secrets in them.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Your public address, no trailing slash (used in SMS links and Paystack return URLs)
NEXT_PUBLIC_SITE_URL=https://order.iriescuisine.com

# Customer support (shown on the site; E.164 format)
NEXT_PUBLIC_WHATSAPP_NUMBER=+233200000000
NEXT_PUBLIC_SUPPORT_PHONE=+233200000000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@iriescuisine.com

# --- Supabase (Project Settings → API) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (sb_publishable_...) — or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# "Secret key" (sb_secret_...) — or the legacy "service_role" key. SERVER ONLY. Full database access.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Authentication → Hooks → "Send SMS hook" secret (looks like v1,whsec_...)
SUPABASE_SMS_HOOK_SECRET=v1,whsec_xxx

# --- Paystack (Settings → API Keys & Webhooks) ----------------------------------------
# Use sk_test_... until you have tested everything, then switch to sk_live_...
# The same key verifies webhook signatures.
PAYSTACK_SECRET_KEY=sk_test_xxx
# Optional: Paystack needs an email for every payment. Customers who sign in by phone get
# <number>@<this domain>. Defaults to orders.<your site domain>.
# PAYSTACK_FALLBACK_EMAIL_DOMAIN=orders.iriescuisine.com
# Optional extra lock: only accept webhooks from Paystack's published IPs (signature is always checked)
PAYSTACK_ENFORCE_IP_ALLOWLIST=false

# --- SMS (Ghana) ---------------------------------------------------------------------
# arkesel (recommended) | mnotify | console (logs only, for development) | none
SMS_PROVIDER=arkesel
# Optional second provider used automatically if the first one fails
SMS_FALLBACK_PROVIDER=mnotify
# Registered sender ID, max 11 letters/numbers (register it with your SMS provider first)
SMS_SENDER_ID=IriesFood
ARKESEL_API_KEY=xxx
MNOTIFY_API_KEY=xxx

# --- Staff alerts ----------------------------------------------------------------------
# Comma-separated numbers that get an SMS when a paid order waits too long, and for catering enquiries
STAFF_ALERT_PHONES=+233200000001,+233200000002
# Minutes a paid order may wait before the alert SMS
STAFF_ALERT_AFTER_MINUTES=5

# --- Scheduled job ---------------------------------------------------------------------
# Any long random string. Vercel Cron sends it automatically to /api/cron.
CRON_SECRET=generate-a-long-random-string

# --- Error monitoring (optional, recommended) ------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps during the build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
